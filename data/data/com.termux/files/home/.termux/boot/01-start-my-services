#!/data/data/com.termux/files/usr/bin/sh

# Log file for this script's output
BOOT_LOG_FILE=~/termux_boot_main.log

echo "Termux:Boot script 'start_my_services' started at $(date)" >> "$BOOT_LOG_FILE"

# PREFIX should be set by Termux:Boot environment. If not, uncomment and set:
# export PREFIX="/data/data/com.termux/files/usr"
# echo "PREFIX is: $PREFIX" >> "$BOOT_LOG_FILE" # For debugging if needed

# Set SVDIR and LOGDIR as done in profile.d script
export SVDIR="$PREFIX/var/service"
export LOGDIR="$PREFIX/var/log"
echo "SVDIR set to $SVDIR" >> "$BOOT_LOG_FILE"
echo "LOGDIR set to $LOGDIR" >> "$BOOT_LOG_FILE"

SERVICE_DAEMON_SCRIPT="$PREFIX/bin/service-daemon"

# Check if service-daemon script exists
if [ ! -x "$SERVICE_DAEMON_SCRIPT" ]; then # Check for executable
    echo "ERROR: $SERVICE_DAEMON_SCRIPT not found or not executable!" >> "$BOOT_LOG_FILE"
    exit 1
fi

# Attempt to start the service-daemon
echo "Attempting to start service-daemon..." >> "$BOOT_LOG_FILE"

# Execute service-daemon start.
# We will let its output go to the boot log for now, unlike the profile.d script.
# It should background itself due to start-stop-daemon.
"$SERVICE_DAEMON_SCRIPT" start >> "$BOOT_LOG_FILE" 2>&1
START_STATUS=$?

if [ $START_STATUS -eq 0 ]; then
    echo "service-daemon start command executed successfully (exit code 0)." >> "$BOOT_LOG_FILE"
else
    echo "WARNING: service-daemon start command exited with code $START_STATUS." >> "$BOOT_LOG_FILE"
fi

# Check if runsvdir process is running (service-daemon should start it)
# Give it a moment to start
sleep 5
# Use pgrep -x for exact match on runsvdir and -f to check full command line if needed
# The service-daemon script starts $PREFIX/bin/runsvdir
RUNSVDIR_CMD="$PREFIX/bin/runsvdir $SVDIR" # What service-daemon aims to run
if pgrep -f "$RUNSVDIR_CMD" > /dev/null; then
    echo "runsvdir process found running for $SVDIR." >> "$BOOT_LOG_FILE"
else
    # Fallback check, maybe DAEMON_OPTS in service-daemon isn't exactly $SVDIR
    if pgrep -x "runsvdir" > /dev/null; then
        echo "A runsvdir process found running (generic check)." >> "$BOOT_LOG_FILE"
    else
        echo "WARNING: runsvdir process NOT found after attempting to start service-daemon." >> "$BOOT_LOG_FILE"
    fi
fi

# Optional: A small delay to let services come up, then check status
sleep 10
echo "Status check after delay:" >> "$BOOT_LOG_FILE"
"$PREFIX/bin/sv" status "$SVDIR/crond" >> "$BOOT_LOG_FILE" 2>&1 # Be more explicit with path to service
"$PREFIX/bin/sv" status "$SVDIR/sshd" >> "$BOOT_LOG_FILE" 2>&1
echo "---- End of boot script at $(date) ----" >> "$BOOT_LOG_FILE"